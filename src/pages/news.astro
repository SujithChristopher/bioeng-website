---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { newsItems } from '../data/news';

---

<Layout title="News - Department of Bioengineering, CMC Vellore">
  <div class="min-h-screen bg-white">
    <Header />

    <!-- Page Header -->
    <section class="py-12 bg-navy-900 text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4 font-serif">News</h1>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Latest developments and updates from the Department of Bioengineering, CMC Vellore
        </p>
      </div>
    </section>

    <section class="py-12 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="divide-y divide-gray-100">
          {newsItems.map((item) => (
            <details class="group py-2">
              <summary class="cursor-pointer list-none flex gap-4 items-start py-2 hover:bg-gray-50 rounded px-2 -mx-2 transition-colors">
                {item.image ? (
                  <img
                    src={item.image}
                    alt={item.title}
                    class="w-16 h-16 object-cover rounded shrink-0 bg-gray-100"
                  />
                ) : (
                  <div class="w-16 h-16 rounded shrink-0 bg-navy-50 flex items-center justify-center text-navy-400" aria-hidden="true">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2M8 8h6M8 12h6M8 16h3" />
                    </svg>
                  </div>
                )}
                <div class="min-w-0 flex-1">
                  {item.date && <p class="text-xs text-gray-400 mb-0.5">{item.date}</p>}
                  <p class="text-sm font-medium text-navy-800 leading-snug">{item.title}</p>
                  <p class="text-xs text-gray-500 mt-1 leading-snug line-clamp-2">{item.description}</p>
                </div>
                <svg class="w-4 h-4 text-gray-400 shrink-0 mt-1 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </summary>
              <div class="mt-4 mb-2 ml-2 mr-2">
                <div class="md:flex gap-6 bg-gray-50 border border-gray-200 rounded overflow-hidden">
                  {item.image && (
                    <img
                      src={item.image}
                      alt={item.title}
                      class="md:w-64 w-full h-48 md:h-auto object-cover shrink-0"
                    />
                  )}
                  <div class="p-5">
                    {item.date && <p class="text-xs text-gray-500 mb-1">{item.date}</p>}
                    <h2 class="text-lg font-bold text-navy-800 font-serif mb-2">{item.title}</h2>
                    <p class="text-sm text-gray-700 leading-relaxed">{item.description}</p>
                  </div>
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <Footer />
  </div>
</Layout>
